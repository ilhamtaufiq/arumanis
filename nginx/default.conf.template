# Static SPA Arumanis. Dipasang ke /etc/nginx/templates/ pada image nginx resmi
# (envsubst mengisi ${...} saat container start).
#
#   API_UPSTREAM  pintu masuk API (Apache -> Rust/Laravel), default http://apiamis.test
#   API_HOST      header Host untuk API, default apiamis.test
#   BFF_UPSTREAM  BFF sementara, untuk fitur yang belum dipindah, default http://127.0.0.1:8787

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 200m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied expired no-cache no-store private auth;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml application/javascript application/json;

    # Shell SPA tidak boleh di-cache, supaya build baru langsung terbaca
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri =404;
    }

    # version.json adalah heartbeat detektor update, harus selalu segar
    location = /version.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        try_files $uri =404;
    }

    location ~* \.(js|mjs|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2|ttf|eot|map)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # API: Rust (sebagian rute) dan Laravel (sisanya), lewat front door Apache
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host ${API_HOST};
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    # Sisa fitur di BFF (dihapus setelah dipindah ke Rust): SIPD, Instagram/Meta,
    # analytics, broadcasting, impersonasi, uji AI, storage, dokumentasi, dan SEO.
    location /bff/ {
        proxy_pass ${BFF_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location /storage/ {
        proxy_pass ${BFF_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # OnlyOffice (HTTP + WebSocket) lewat BFF
    location /office {
        proxy_pass ${BFF_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
    }

    # Batas path dengan regex supaya /documents atau /publikasi-lain tidak ikut
    location ~ ^/(health|docs|publikasi|puspen)(/|$) {
        proxy_pass ${BFF_UPSTREAM};
        proxy_set_header Host $host;
    }
    location = /sitemap.xml { proxy_pass ${BFF_UPSTREAM}; proxy_set_header Host $host; }

    # SPA: semua rute lain dilayani dari dist
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        try_files $uri $uri/ /index.html;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
}
